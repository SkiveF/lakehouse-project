# Copier ce fichier en .env et remplir les valeurs
# ── MinIO ──────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# ── Spark / S3A ────────────────────────────────────
SPARK_S3A_ACCESS_KEY=
SPARK_S3A_SECRET_KEY=
# ── Airflow ────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=

# -- Hive Metastore (PostgreSQL hote) --------------
METASTORE_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/hive_metastore
METASTORE_USER=
METASTORE_PASSWORD=

# -- Ressources Spark Thrift Server ---------------
# Laisser de la place aux spark-submit : total cores machine - THRIFT_TOTAL_CORES
THRIFT_TOTAL_CORES=4
THRIFT_EXECUTOR_MEMORY=1g
