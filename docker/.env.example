 Copier ce fichier en .env et remplir les valeurs
# ── MinIO ──────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# ── Spark / S3A ────────────────────────────────────
SPARK_S3A_ACCESS_KEY=
SPARK_S3A_SECRET_KEY=
# ── Airflow ────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=
